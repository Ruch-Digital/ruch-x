# ruch-x.toml — copie para a raiz do projeto e ajuste.
# Tudo aqui é opcional. Sem este arquivo a coleta usa os padrões.
# Segredo NUNCA entra aqui: DSN e tokens vêm de variável de ambiente.
#
# CAMINHO FORA DA RAIZ É RECUSADO. As chaves de caminho — manage_py, python,
# apps_dir/modules_dir, coverage_file, coverage_json — são resolvidas DENTRO da
# raiz do repositório e precisam existir. Absoluto ("/etc/passwd") e "../" caem
# fora e voltam pro padrão; nunca viram argumento de comando.

project = "meu-projeto"     # aparece como título do dashboard; padrão é o nome da pasta
apps_dir = "apps"           # onde ficam os apps Django; se não existir, procura por apps.py
manage_py = "manage.py"     # ponto de entrada do Django; some o coletor inteiro se não resolver

# Interpretador usado pro manage.py e pro `pip list --outdated` — o venv do
# projeto. Fora da raiz é recusado e vale o interpretador de quem está auditando.
# ATENÇÃO: o valor aceito é EXECUTADO e vem de dentro do repositório — inclusive
# com --skip django (o `pip list` é do coletor governance). Em repositório
# alheio, leia esta chave antes de rodar. Detalhe em docs/security.md §6.
# python = "venv/bin/python"        # Windows: "venv/Scripts/python.exe"

# Rodar a suíte de testes durante a coleta. Deixe false e rode os testes no seu
# fluxo normal com --cov-report=json — a coleta lê o coverage.json que sobra.
# ATENÇÃO: true faz a coleta EXECUTAR a suíte do repositório (conftest.py é
# código arbitrário). Não ligue em repositório de terceiro — veja docs/security.md.
run_tests = false
coverage_json = "coverage.json"   # se este arquivo já existe, a suíte não é rodada
pytest_args = ["-q", "--cov", "--cov-report=json", "--durations=10"]
test_timeout = 900                # segundos até a suíte ser morta

# Relatório de cobertura em caminho fora do convencional. Só JSON é lido por
# aqui (formato coverage.py ou Istanbul); XML/lcov precisam estar num dos
# caminhos padrão listados em docs/languages.md.
# coverage_file = "build/coverage.json"

# Janela do mapa de atrito. Projeto novo pede janela menor; legado pede maior.
hotspot_window = "180 days ago"

[django]
# `check --deploy` roda com o settings do ambiente atual — numa máquina de dev
# ele acusa DEBUG/SSL que só valem em produção. Aponte o módulo de produção pra
# ter o retrato que interessa (o coletor só lê a saída; não sobe servidor).
# Se o settings de produção exigir variáveis (SECRET_KEY etc), exporte antes.
settings_module = "meuprojeto.settings.production"

[infra]
# Easypanel e qualquer VPS: aponte o cliente Docker pro host por SSH.
# Precisa de chave SSH sem senha. Teste com: DOCKER_HOST=ssh://root@host docker ps
docker_host = "ssh://root@meu-vps"
project_prefix = "meuprojeto"   # OBRIGATÓRIO pro coletor infra: vínculo repo<->containers
                                # (sem ele a seção sai como "não auditado" — o Docker é do host)

[ci]
limit = 40                       # quantas execuções do GitHub Actions analisar

[dora]
# Como reconhecer um deploy no histórico do Actions. O padrão procura
# "deploy", "release", "publish" e "cd" no nome do workflow.
deploy_keywords = ["deploy", "release", "publish", "cd"]
branch = "main"                  # só o que roda na branch de produção conta
limit = 120                      # execuções analisadas para as métricas DORA
limite_vermelhos = 20            # quantas execuções VERMELHAS abrir job a job para
                                 # ver se o deploy em si falhou (execução verde não
                                 # gasta chamada; o que passar do teto conta como falha)

[db]
# O DSN vem de RUCHX_DATABASE_URL (ou DATABASE_URL). Use usuário SOMENTE LEITURA:
#
#   CREATE USER ruchx WITH PASSWORD 'trocar';
#   GRANT pg_monitor TO ruchx;
#   GRANT CONNECT ON DATABASE meubanco TO ruchx;
#
# Multi-tenant com schema por tenant: acrescente ao DSN
#   ?options=-csearch_path%3Dtenant_x
